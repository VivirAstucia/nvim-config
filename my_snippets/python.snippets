snippet mat_mult "matrix_multiplicatoin" b
def mat_mult(A, B, MOD):
    assert len(A[0]) == len(B)
    ans = [[0]*len(B[0]) for _ in range(len(A))]

    for i in range(len(A)):
        for j in range(len(B)):
            if A[i][j] == 0: continue
            for k in range(len(B[0])):
                ans[i][k] += A[i][j] * B[j][k]
                ans[i][k] %= MOD
    return ans
endsnippet

snippet mat_pow "matrix_bin_pow" b
def mat_pow(K, p, MOD):
    assert len(K) == len(K[0])
    n = len(K)

    ans = [[i==j for i in range(n)] for j in range(n)]
    while p:
        if p&1:
            ans = mat_mult(ans, K, MOD)
        K = mat_mult(K, K, MOD)
        p >>= 1
    return ans
endsnippet

snippet skip_list "Ordered Set" b
import random

class Skip_List():
    class Node():
        __slots__ = ['value', 'next', 'down', 'gap']
        def __init__(self, value, next=None, down=None, gap=0):
            self.value, self.next, self.down, self.gap = value, next, down, gap

    MAX_H = 32

    def __init__(self, iterable=None, MIN=float('-inf'), MAX=float('inf')):
        self.length = 0

        self.heads = [self.Node(MIN, self.Node(MAX, gap=1), gap=0) for _ in range(self.MAX_H)]
        for lvl in range(1, self.MAX_H):
            bm,cm = self.heads[lvl-1], self.heads[lvl]
            bM, cM = bm.next, cm.next
            assert bM is not None and cM is not None
            cm.down, cM.down = bm, bM

        self.randbits = 0
        self.curr_lvl = 0
        if iterable is not None:
            for x in iterable:
                self.insert(x)

    def _roll(self) -> bool:
        if self.randbits == 0: self.randbits = random.getrandbits(64)
        x = self.randbits&1
        self.randbits >>= 1
        return x

    def insert(self, x) -> None:
        update, steps = [None]*self.MAX_H, [0]*self.MAX_H
        curr, pos = self.heads[self.curr_lvl], 0

        for i in range(self.curr_lvl, -1, -1):
            while curr.next.next is not None and x >= curr.next.value:
                pos += curr.next.gap
                curr = curr.next
            update[i], steps[i] = curr, pos
            if i > 0: curr = curr.down

        lvl = 0
        while self._roll() and lvl < self.MAX_H - 1:
            lvl += 1

        if lvl > self.curr_lvl:
            for i in range(self.curr_lvl + 1, lvl + 1):
                update[i], steps[i] = self.heads[i], 0
                self.heads[i].next.gap = self.length + 1
            self.curr_lvl = lvl

        last_down = None
        for i in range(lvl + 1):
            prev, nxt = update[i], update[i].next
            gap = (pos + 1) - steps[i]
            nd = self.Node(x, nxt, last_down, gap)
            prev.next = last_down = nd
            if nxt: nxt.gap += 1 - gap

        for i in range(lvl + 1, self.curr_lvl + 1):
            if update[i].next: update[i].next.gap += 1

        self.length += 1

    def remove(self, value) -> None:
        update = [None] * self.MAX_H
        curr = self.heads[self.curr_lvl]

        for i in range(self.curr_lvl, -1, -1):
            while curr.next.next is not None and value > curr.next.value:
                curr = curr.next
            update[i] = curr
            if i > 0: curr = curr.down

        target = update[0].next
        if target is not None and target.value == value:
            removed_down = None
            for i in range(self.curr_lvl + 1):
                nxt = update[i].next
                if nxt and nxt.value == value and (i == 0 or nxt.down is removed_down):
                    removed_down = nxt
                    update[i].next = nxt.next
                    if nxt.next: nxt.next.gap += nxt.gap - 1
                elif nxt:
                    nxt.gap -= 1
            self.length -= 1
        else:
            raise ValueError(f"{value} not in skip list")

    def pop(self, idx:int):
        "removes and returns the val at idx"
        val = self[idx]
        self.remove(val)
        return val

    def count(self, value) -> int:
        "returns no of occurences of val"
        return self.bisect_right(value) - self.bisect_left(value)

    def bisect_left(self, value) -> int:
        "return i s.t. for all k>=i -> A[k]>=value"
        curr = self.heads[self.curr_lvl]
        idx = 0
        for i in range(self.curr_lvl, -1, -1):
            while curr.next.next is not None and value > curr.next.value:
                idx += curr.next.gap
                curr = curr.next
            if i > 0: curr = curr.down
        return idx

    def bisect_right(self, value) -> int:
        "returns i s.t. for all k>=i -> A[k]>value"
        curr = self.heads[self.curr_lvl]
        idx = 0
        for i in range(self.curr_lvl, -1, -1):
            while curr.next.next is not None and value >= curr.next.value:
                idx += curr.next.gap
                curr = curr.next
            if i > 0: curr = curr.down
        return idx

    def index(self, value) -> int:
        "returns smallest i s.t. A[i] == value, else -1"
        idx = self.bisect_left(value)
        if idx < self.length and self[idx] == value:
            return idx
        return -1

    def __contains__(self, value) -> bool:
        return self.count(value) >= 1

    def __getitem__(self, idx:int):
        if not (0<=idx<self.length): raise IndexError
        idx += 1
        curr = self.heads[self.curr_lvl]
        for i in range(self.curr_lvl, -1, -1):
            while curr.next.next is not None and idx - curr.next.gap >= 0:
                idx -= curr.next.gap
                curr = curr.next
            if i > 0: curr = curr.down
        if idx == 0: return curr.value
        assert False

endsnippet
