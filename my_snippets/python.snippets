snippet union_find "DSU" b
class UnionFind:
    def __init__(self, n, size=None):
        self.parent = list(range(n))
        self.size = [1] * n if size is None else size

    def find(self, a):
        _a = a
        while a != self.parent[a]:
            a = self.parent[a]
        while _a != self.parent[_a]:
            self.parent[_a], _a = a, self.parent[_a]
        return a

    def union(self, a, b):
        pa, pb = self.find(a), self.find(b)
        if pa == pb:
            return False
        if self.size[pa] < self.size[pb]:
            pa, pb = pb, pa
        self.parent[pb] = pa
        self.size[pa] += self.size[pb]
        return True

    def get_size(self, a):
        return self.size[self.find(a)]
endsnippet

snippet fenwick_tree "Fenwick Tree + kth" b
class FenwickTree:
    def __init__(self, n):
        self.n = n
        self.tree = [0]*(n+2)
        self.max_pow2 = 1 << (self.n.bit_length() - 1) if self.n > 0 else 0

    def update(self, idx, val):
        while idx <= self.n:
            self.tree[idx] += val
            idx += idx & -idx

    def range_update(self, l, r, val):
        self.update(l, val)
        self.update(r+1, -val)

    def query(self, idx):
        res = 0
        while idx > 0:
            res += self.tree[idx]
            idx -= idx & -idx
        return res

    def range_query(self, l, r):
        return self.query(r) - self.query(l-1)

    # 1 based rank, 1 indexed return value
    def find_kth(self, k):
        """
        finds the 1 indexed value of the kth smallest inserted element in O(log N).
        returns None if k > total inserted elements or k <= 0.
        """
        idx = 0
        curr_sum = 0
        mask = self.max_pow2

        while mask > 0:
            next_idx = idx + mask
            if next_idx <= self.n and curr_sum + self.tree[next_idx] < k:
                idx = next_idx
                curr_sum += self.tree[idx]
            mask >>= 1

        ans = idx + 1
        return ans if ans <= self.n and self.query(ans) >= k else None
endsnippet

snippet segment_tree "Segment tree" b
class SegmentTree:
    def __init__(self, A, d=0, f=lambda a, b: a + b):
        self.n, self.d, self.f = len(A), d, f
        self.t = [d] * (2 * self.n)
        self.t[self.n:] = A
        for i in range(self.n - 1, 0, -1):
            self.t[i] = f(self.t[i<<1], self.t[i<<1|1])

    def update(self, p, v):
        p += self.n
        self.t[p] = v
        while p > 1:
            p >>= 1
            self.t[p] = self.f(self.t[p<<1], self.t[p<<1|1])

    def query(self, l, r):
        l += self.n
        r += self.n + 1
        a = b = self.d
        while l < r:
            if l & 1:
                a = self.f(a, self.t[l])
                l += 1
            if r & 1:
                r -= 1
                b = self.f(self.t[r], b)
            l >>= 1
            r >>= 1
        return self.f(a, b)
endsnippet

snippet lazy_st "Iterative Lazy Segment Tree (Range Add, Range Max)" b
class LazyST:
    def __init__(self, A):
        self.n = len(A)
        self.h = self.n.bit_length()
        self.t = [0] * (2 * self.n)
        self.d = [0] * self.n
        self.t[self.n:] = A
        for i in range(self.n - 1, 0, -1):
            self.t[i] = max(self.t[i<<1], self.t[i<<1|1])

    def apply(self, p, v):
        self.t[p] += v
        if p < self.n:
            self.d[p] += v

    def build(self, p):
        while p > 1:
            p >>= 1
            self.t[p] = max(self.t[p<<1], self.t[p<<1|1]) + self.d[p]

    def push(self, p):
        for s in range(self.h, 0, -1):
            i = p >> s
            if self.d[i]:
                self.apply(i<<1, self.d[i])
                self.apply(i<<1|1, self.d[i])
                self.d[i] = 0

    def upd(self, l, r, v):
        l += self.n
        r += self.n
        l0, r0 = l, r - 1
        self.push(l0)
        self.push(r0)
        while l < r:
            if l & 1:
                self.apply(l, v)
                l += 1
            if r & 1:
                r -= 1
                self.apply(r, v)
            l >>= 1
            r >>= 1
        self.build(l0)
        self.build(r0)

    def qry(self, l, r):
        l += self.n
        r += self.n
        self.push(l)
        self.push(r - 1)
        res = float('-inf')
        while l < r:
            if l & 1:
                res = max(res, self.t[l])
                l += 1
            if r & 1:
                r -= 1
                res = max(res, self.t[r])
            l >>= 1
            r >>= 1
        return res
endsnippet

snippet sparse_table "Sparse table (idempotent)" b
def sparse_table(arr, func):
    n = len(arr)
    LOG = n.bit_length()

    res = [[0] * n for _ in range(LOG)]
    res[0] = arr

    for i in range(1, LOG):
        for j in range(n - (1 << i) + 1):
            res[i][j] = func(res[i - 1][j], res[i - 1][j + (1 << (i - 1))])

    def query(l, r):
        k = (r - l + 1).bit_length() - 1
        return func(res[k][l], res[k][r - (1 << k) + 1])

    return query
endsnippet

snippet sparse_table_full "Sparse table (associative)" b
def sparse_table_full(arr, func):
    n = len(arr)
    LOG = n.bit_length()

    res = [[0] * n for _ in range(LOG)]
    res[0] = arr

    for i in range(1, LOG):
        for j in range(n - (1 << i) + 1):
            res[i][j] = func(res[i - 1][j], res[i - 1][j + (1 << (i - 1))])

    def query(l, r):
        ans = None
        m = r - l + 1
        while m > 0:
            k = m.bit_length() - 1
            ans = func(ans, res[k][l]) if ans is not None else res[k][l]
            l += 1 << k
            m -= 1 << k
        return ans

    return query
endsnippet

