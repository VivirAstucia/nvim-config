snippet prime_table "Prime table with phi and mu" b
class PrimeTable:

    def __init__(self, n: int) -> None:
        self.n = n
        self.primes = []
        self.max_div = list(range(n + 1))
        self.max_div[1] = 1
        self.phi = [0] * (n + 1)
        self.mu = [0] * (n + 1)
        lp = [0] * (n + 1)
        self.phi[1] = 1
        self.mu[1] = 1

        for i in range(2, n + 1):
            if lp[i] == 0:
                lp[i] = i
                self.primes.append(i)
                self.phi[i] = i - 1
                self.mu[i] = -1
            for p in self.primes:
                x = i * p
                if x > n:
                    break
                lp[x] = p
                self.max_div[x] = p
                if i % p == 0:
                    self.phi[x] = self.phi[i] * p
                    self.mu[x] = 0
                    break
                self.phi[x] = self.phi[i] * (p - 1)
                self.mu[x] = -self.mu[i]

    def is_prime(self, x: int):
        if x < 2:
            return False
        if x <= self.n:
            return self.max_div[x] == x
        for p in self.primes:
            if p * p > x:
                break
            if x % p == 0:
                return False
        return True

    def prime_factorization(self, x: int):
        if x > self.n:
            for p in self.primes:
                if p * p > x:
                    break
                if x <= self.n:
                    break
                if x % p == 0:
                    cnt = 0
                    while x % p == 0:
                        cnt += 1
                        x //= p
                    yield p, cnt
        while 1 < x <= self.n:
            p, cnt = self.max_div[x], 0
            while x % p == 0:
                cnt += 1
                x //= p
            yield p, cnt
        if x > 1:
            yield x, 1

    def get_factors(self, x: int):
        factors = [1]
        for p, b in self.prime_factorization(x):
            m = len(factors)
            for j in range(1, b + 1):
                for d in factors[:m]:
                    factors.append(d * (p ** j))
        return factors
endsnippet

snippet factorial_mod "Factorial mod" b
class Factorial:
    def __init__(self, N, mod) -> None:
        N += 1
        self.mod = mod
        self.f = [1 for _ in range(N)]
        self.g = [1 for _ in range(N)]
        for i in range(1, N):
            self.f[i] = self.f[i - 1] * i % self.mod
        self.g[-1] = pow(self.f[-1], mod - 2, mod)
        for i in range(N - 2, -1, -1):
            self.g[i] = self.g[i + 1] * (i + 1) % self.mod

    def fac(self, n):
        return self.f[n]

    def fac_inv(self, n):
        return self.g[n]

    def comb(self, n, m):
        if n < m or m < 0 or n < 0:
            return 0
        return self.f[n] * self.g[m] % self.mod * self.g[n - m] % self.mod

    def perm(self, n, m):
        if n < m or m < 0:
            return 0
        return self.f[n] * self.g[n - m] % self.mod

    def catalan(self, n):
        return (self.comb(2 * n, n) - self.comb(2 * n, n - 1)) % self.mod

    def inv(self, n):
        return self.f[n - 1] * self.g[n] % self.mod
endsnippet

snippet mat_mult "matrix multiplication" b
def mat_mult(A, B, MOD):
    assert len(A[0]) == len(B)
    ans = [[0] * len(B[0]) for _ in range(len(A))]

    for i in range(len(A)):
        for j in range(len(B)):
            if A[i][j] == 0:
                continue
            for k in range(len(B[0])):
                ans[i][k] += A[i][j] * B[j][k]
                ans[i][k] %= MOD
    return ans
endsnippet

snippet mat_pow "matrix binary exponentiation" b
def mat_pow(K, p, MOD):
    assert len(K) == len(K[0])
    n = len(K)

    ans = [[1 if i == j else 0 for i in range(n)] for j in range(n)]
    while p:
        if p & 1:
            ans = mat_mult(ans, K, MOD)
        K = mat_mult(K, K, MOD)
        p >>= 1
    return ans
endsnippet

