snippet is_bipartite "is bipartite" b
def is_bipartite(adj, n):
    color = [-1] * n
    for i in range(n):
        if color[i] != -1:
            continue
        q = [i]
        color[i] = 0
        for u in q:
            for v in adj[u]:
                if color[v] == -1:
                    color[v] = color[u] ^ 1
                    q.append(v)
                elif color[v] == color[u]:
                    return False
    return True
endsnippet

snippet toposort "toposort" b
def toposort(adj, n):
    ind = [0] * n
    for u in range(n):
        for v in adj[u]:
            ind[v] += 1
    q = [i for i in range(n) if ind[i] == 0]
    res = []
    for u in q:
        res.append(u)
        for v in adj[u]:
            ind[v] -= 1
            if ind[v] == 0:
                q.append(v)
    return res if len(res) == n else []
endsnippet

snippet dijkstra "Dijkstra" b
import heapq
def dijkstra(adj, n, src):
    dist = [float('inf')] * n
    dist[src] = 0
    pq = [(0, src)]
    while pq:
        d, u = heapq.heappop(pq)
        if d > dist[u]:
            continue
        for v, w in adj[u]:
            if dist[u] + w < dist[v]:
                dist[v] = dist[u] + w
                heapq.heappush(pq, (dist[v], v))
    return dist
endsnippet

snippet bfs01 "0-1 BFS" b
from collections import deque
def bfs01(adj, n, src):
    dist = [float('inf')] * n
    dist[src] = 0
    q = deque([src])
    while q:
        u = q.popleft()
        for v, w in adj[u]:
            if dist[u] + w < dist[v]:
                dist[v] = dist[u] + w
                if w == 1:
                    q.append(v)
                else:
                    q.appendleft(v)
    return dist
endsnippet

snippet graph_reference_latex "Graph reference (LaTeX)" b
\section*{Graph Ideas / Theorems}
\begin{itemize}
\item \textbf{Kruskal Reconstruction Tree (KRT):} sort edges by weight, merge DSU components, and build a merge tree; path queries reduce to LCA on KRT.
\item \textbf{Floyd--Warshall:} all-pairs shortest paths in $O(n^3)$; update by $d_{ij} = \min(d_{ij}, d_{ik} + d_{kj})$.
\item \textbf{Cycle detection:} undirected via DSU/DFS parent check, directed via DFS colors or Kahn (remaining nodes imply cycle).
\item \textbf{Functional (Rho) graph:} each node has out-degree $1$; decompose into directed cycles with in-trees attached.
\item \textbf{SCC:} Kosaraju / Tarjan to condense directed graph into a DAG.
\item \textbf{Bridges \/ Articulation points:} Tarjan low-link on DFS tree.
\item \textbf{MST:} Kruskal ($O(m\log m)$) or Prim ($O(m\log n)$ with heap).
\item \textbf{Bellman--Ford:} handles negative edges; detects reachable negative cycles.
\item \textbf{$0$--$1$ BFS:} shortest path with edge weights in $\{0,1\}$ using deque.
\item \textbf{Max flow:} Dinic for blocking-flow based $s$-$t$ max flow.
\item \textbf{Matching:} Hopcroft--Karp for bipartite maximum matching.
\item \textbf{Tree diameter:} two BFS/DFS passes or tree DP.
\end{itemize}
endsnippet

