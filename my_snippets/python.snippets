snippet binary_lifting_kth_ancestor "kth ancestor" b
ancestor = [p] #ancestor[i][x] contains 2**ith ancestor of x
for i in range(n.bit_length()):
    na = [(ancestor[-1][nd] if nd != -1 else -1) for nd in ancestor[-1]]
    ancestor.append(na)

def kth_ancestor(nd, k):
    if k.bit_length() >= n.bit_length(): return -1
    for i in range(k.bit_length()):
        if k&(1<<i):
            if nd == -1: return -1
            nd = ancestor[i][k]
    return nd
endsnippet

snippet binary_lifting_lca "lca" b
def lca(a: int, b: int, ancestor: list[list[int]], depth: list[int], max_log) -> int:
    if depth[a] < depth[b]: a, b = b, a

    diff = depth[a] - depth[b]
    for i in range(max_log):
        if (diff >> i) & 1:
            a = ancestor[i][a]
    if a == b: return a

    for i in range(max_log - 1, -1, -1):
        if ancestor[i][a] != ancestor[i][b]:
            a = ancestor[i][a]
            b = ancestor[i][b]
    return ancestor[0][a]
endsnippet

snippet euler_tour "euler_tour" b
tour = []
tin = [-1]*(n+1)
depth = [0]*(n+1)
stack = [1]
while stack:
    nd = stack.pop()
    if nd > 0:
        tin[nd] = len(tour)
        tour.append((depth[nd], nd))

        for nei in children[nd]:
            stack.append(-nd)
            stack.append(nei)
            depth[nei] = depth[nd] + 1
    else:
        nd = -nd
        tour.append((depth[nd], nd))
endsnippet

snippet hld "lca heavy-light decomposition" b
order = [1]
parent = [-1]*(n+1)
depth = [0]*(n+1)
for u in order:
    for v in g[u]:
        if v == parent[u]: continue
        depth[v] = depth[u] + 1
        parent[v] = u
        order.append(v)

size = [1]*(n+1)
heavy = [1]*(n+1)
for u in reversed(order):
    mx = 0
    for v in g[u]:
        if v == parent[u]: continue
        size[u] += size[v]
        if size[v] > mx:
            heavy[u], mx = v, size[v]

head = [0]*(n+1)
for u in order:
    for v in g[u]:
        if v == parent[u]: continue
        if heavy[u] == v:
            head[v] = head[u]
        else:
            head[v] = v
endsnippet

