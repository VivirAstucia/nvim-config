snippet permutations_invert "invert permutation" b
def invert_permutation(perm):
    ans = [0] * len(perm)
    for i, v in enumerate(perm):
        ans[v] = i
    return ans
endsnippet

snippet permutations_multiply "multiply permutations" b
def multiply_permutation(p1, p2):
    ans = [0] * len(p1)
    for i in range(len(p1)):
        ans[i] = p1[p2[i]]
    return ans
endsnippet

snippet permutation_to_cycles "cycle decomposition" b
def cycle_decomposition(p: list[int]) -> list[list[list[int]]]:
    n = len(p)
    vis = [0] * n
    cycles = [[] for _ in range(n + 1)]
    for i in range(n):
        if vis[i]:
            continue
        curr = i
        path = []
        while not vis[curr]:
            vis[curr] = 1
            path.append(curr)
            curr = p[curr]
        cycles[len(path)].append(path)
    return cycles
endsnippet

snippet permutations_from_cycles "cycle composition" b
def cycle_composition(res_cycles: list[list[int]], n: int) -> list[int]:
    res = list(range(n))
    for cycle in res_cycles:
        if not cycle:
            continue
        m = len(cycle)
        for i in range(m):
            res[cycle[i]] = cycle[(i + 1) % m]
    return res
endsnippet

